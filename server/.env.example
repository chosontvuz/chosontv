PORT=5000
MONGO_URI=
JWT_SECRET=
ADMIN_PASSWORD=
BOT_TOKEN=
CORS_ORIGIN=
BODY_LIMIT=200mb
CLIENT_BUILD_PATH=

# Telegram Mini App / client sayt (Tomosha qilish tugmasi).
# Sitemap ham shu domendan yig'iladi (GET /sitemap.xml).
# Masalan: https://www.chosontv.uz
WEB_APP_URL=https://www.chosontv.uz

# Ixtiyoriy: IndexNow kaliti (Bing/Yandex tezroq bilishi uchun).
# Bo'sh qoldirilsa faqat Bing sitemap ping ishlaydi.
INDEXNOW_KEY=

# Cloudflare R2 — Render Environment da ham shu nomlar bilan bering.
# Secretlarni hech qachon kodga yozmang.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Public media URL (custom domain yoki r2.dev).
# Masalan: https://media.chosontv.com
# Bo'sh qoldirilsa, keyingi R2 service getPublicUrl() fallback ishlatadi;
# domain ulanganda faqat shu qiymatni o'zgartiring — kod o'zgarmaydi.
R2_PUBLIC_URL=
